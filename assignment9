print(prices.dtype)

#2

prices = np.array([299, 499, 799, 0, 1599, -1, 899])
average = np.mean(prices[prices > 0])
prices[prices <= 0] = average
print(prices)


#3

quantities = np.array([2, 1, 3, 4, 2, 1, 5])
bill = prices * quantities
print(bill)

#4

print("Minimum:", np.min(prices))
print("Maximum:", np.max(prices))
print("Average:", np.mean(prices))
print("Total:", np.sum(prices))
print("Total Bill:", np.sum(bill))


#5

unique_prices = np.unique(prices)
print("Unique price values:", len(unique_prices))