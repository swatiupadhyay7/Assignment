prices = np.array([120, 250, 180, 90, 150, 200, 75, 300, 110, 160, 220, 130])
ravel_prices = prices.ravel()
flatten_prices = prices.flatten()
prices.resize(3, 4)


print("ravel():", ravel_prices)
print("Original:", prices)
print("flatten():", flatten_prices)
print("resize():")
print(prices)


