#4

messages = np.array([
    [25, 30, 28, 35, 40, 32, 38],
    [15, 18, 20, 17, 22, 19, 21],
    [40, 45, 38, 42, 50, 48, 46],
    [10, 12, 8, 15, 11, 9, 13]
])

new_user = np.array([[30, 35, 32, 40, 45, 38, 42]])
messages = np.insert(messages, 4, new_user, axis=0)

totals = np.sum(messages, axis=1)
least_user = np.argmin(totals)

messages = np.delete(messages, least_user, axis=0)
print(messages)


